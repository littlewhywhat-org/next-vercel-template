{
  "name": "next-vercel-ci-template",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "ci": "biome check . && tsc --noEmit && tsx node_modules/@cucumber/cucumber/bin/cucumber.js --dry-run",
    "test:e2e": "tsx node_modules/@cucumber/cucumber/bin/cucumber.js",
    "test:e2e:dry": "tsx node_modules/@cucumber/cucumber/bin/cucumber.js --dry-run"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.1",
    "motion": "^14.0.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@cucumber/cucumber": "^12.9.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "wait-on": "^9.5.1"
  },
  "engines": {
    "node": "24.x"
  },
  "volta": {
    "node": "24.14.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
